{
  "name": "gcrindex-spring-hope-patient-form",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "d1_databases": [
    {
      "binding": "springhope_db",
      "database_name": "springhope-db",
      "database_id": "b95de5af-caa2-4bfa-96c4-2e56957af865",
      "remote": true
    }
  ]
}
